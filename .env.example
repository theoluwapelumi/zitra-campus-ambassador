# ===========================================
# Vercel Postgres Database
# ===========================================
# These are automatically added when you create a Vercel Postgres database
# Run: vercel env pull .env.local
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://...?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."

# ===========================================
# Cloudinary (File Uploads)
# ===========================================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ===========================================
# SMTP Email Configuration
# ===========================================
# For Gmail: use smtp.gmail.com, port 587, and an App Password
# For SendGrid: use smtp.sendgrid.net, port 587
# For Mailgun: use smtp.mailgun.org, port 587
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Zitra Campus Ambassador <ambassadors@zitrabank.com>"
ADMIN_EMAIL="admin@zitrabank.com"

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_LOGO_URL="https://res.cloudinary.com/your-cloud/image/upload/v1234/zitra-logo.png"
